# Configuración para DESARROLLO LOCAL. Para producción usa .env.production.example.
# Copia este archivo a .env y ejecuta: php artisan key:generate

APP_NAME=Proyetech
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_TIMEZONE=America/Guayaquil

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=home
DB_USERNAME=root
DB_PASSWORD=root

# Redis es obligatorio para php artisan serve (caché, sesiones, colas y visitas).
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SERIALIZATION=json
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Correo local tipo Mailpit (http://localhost:8025).
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=no-reply@proyetech.test
MAIL_FROM_NAME="${APP_NAME}"

# Marketplace (config/marketplace.php)
MARKETPLACE_CACHE_TTL=3600
FREE_SERVICE_LIMIT=3
LEAD_NOTIFICATION_ADDRESS=
MARKETPLACE_CONTACT_PHONE=
MARKETPLACE_CONTACT_EMAIL=
MARKETPLACE_WHATSAPP_COUNTRY_CODE=593

# Cambiar ubicación con Google Places (opcional).
GOOGLE_MAPS_API_KEY=

# Plan Pro (config/billing.php): solo transferencia y efectivo. Ver docs/04-pagos.md.
BILLING_PRO_PRICE=8.00
BILLING_PRO_PERIOD_DAYS=30
BILLING_TAX_RATE=0
BILLING_BANK_NAME=
BILLING_BANK_ACCOUNT_TYPE=Ahorros
BILLING_BANK_ACCOUNT_NUMBER=
BILLING_BANK_HOLDER=
BILLING_BANK_HOLDER_ID=
PAYPHONE_ENABLED=false
