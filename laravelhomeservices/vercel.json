{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.8.0",
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/(css|js|images)/(.*)",
      "dest": "/$1/$2"
    },
    {
      "src": "/(favicon\\.(?:ico|png)|robots\\.txt)",
      "dest": "/$1"
    },
    {
      "src": "/(\\.env.*|\\.git.*|composer\\.(json|lock)|package(-lock)?\\.json|artisan|phpunit\\.xml|webpack\\.mix\\.js|tailwind\\.config\\.js|vercel\\.json|README\\.md|pasos .*|(app|bootstrap|config|database|docs|lang|resources|routes|storage|tests|vendor|api|node_modules)(/.*)?)",
      "status": 404
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "crons": [
    {
      "path": "/cron/diario",
      "schedule": "0 11 * * *"
    }
  ]
}
