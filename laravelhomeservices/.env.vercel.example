# Variables para Vercel (Project → Settings → Environment Variables). Guía: docs/06-despliegue-y-operacion.md
# No hace falta Redis ni disco: sesiones y caché van a la base de datos, y los archivos a un almacenamiento tipo S3.

APP_NAME=Malakplace
APP_ENV=production
# php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://tu-dominio.example
APP_LOCALE=es
APP_TIMEZONE=America/Guayaquil
LOG_CHANNEL=stderr
TRUSTED_PROXIES=*

# Base de datos accesible desde internet, en la misma región que la función (Vercel usa iad1 por defecto).
# El despliegue actual usa Postgres de Supabase: DB_CONNECTION=pgsql y la integración crea POSTGRES_URL_NON_POOLING
# (sin DB_HOST ni el resto). Abajo, el caso MySQL.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Si el proveedor exige TLS, ruta del certificado incluido en Lambda:
MYSQL_ATTR_SSL_CA=/etc/pki/tls/certs/ca-bundle.crt

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SERIALIZATION=json
CACHE_DRIVER=database
QUEUE_CONNECTION=sync
VISIT_COUNTER=database

# Fotos públicas: un bucket con lectura pública (AWS_URL es su dirección pública).
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_URL=
# Solo para servicios compatibles (Cloudflare R2: https://<cuenta>.r2.cloudflarestorage.com)
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Comprobantes de pago y subidas temporales: un segundo bucket PRIVADO, con CORS que permita PUT desde tu dominio.
RECEIPTS_BUCKET=
LIVEWIRE_TEMP_DISK=receipts

# Correo por SMTP. MAIL_TIMEOUT corto: se envía durante la petición (no hay cola).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=5
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Malakplace

# Vercel Cron lo envía solo al llamar a /cron/diario. Genera un valor largo y aleatorio.
CRON_SECRET=

MARKETPLACE_CONTACT_PHONE=
MARKETPLACE_CONTACT_EMAIL=
MARKETPLACE_WHATSAPP_COUNTRY_CODE=593
LEAD_NOTIFICATION_ADDRESS=
FREE_SERVICE_LIMIT=3
MARKETPLACE_CACHE_TTL=3600

BILLING_PRO_PRICE=8.00
BILLING_PRO_PERIOD_DAYS=30
BILLING_TAX_RATE=0
BILLING_BANK_NAME=
BILLING_BANK_ACCOUNT_TYPE=Ahorros
BILLING_BANK_ACCOUNT_NUMBER=
BILLING_BANK_HOLDER=
BILLING_BANK_HOLDER_ID=
PAYPHONE_ENABLED=false
