includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - app
        - config
        - database
        - routes
    tmpDir: storage/framework/phpstan
    ignoreErrors:
        # Redis::eval() de Laravel acepta (script, cantidad de claves, ...claves y argumentos), pero
        # PHPStan lo compara con la firma de la extensión phpredis, que cambia según la versión
        # instalada: en una máquina aparece y en otra no. Por eso sin reportUnmatched.
        -
            message: '#Redis\:\:eval\(\)#'
            path: app/Services/ServiceVisitCounter.php
            reportUnmatched: false
